{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "buildId", "runId", "payloadDigest", "baselineRevision", "screens"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "buildId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "payloadDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baselineRevision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approvedBaseline": {"type": "string"},
    "note": {"type": "string"},
    "evidenceRoot": {"type": "string"},
    "screens": {"type": "object", "additionalProperties": {
      "type": "object", "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pass", "fail", "failed", "not_run", "blocked", "partial", "pending", "missing"]},
        "note": {"type": "string"}, "candidateHash": {"type": "string"},
        "runId": {"type": "string"}, "buildId": {"type": "string"},
        "baseline": {"type": "string"}, "baselineHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "screenshot": {"type": "string"}, "screenshotHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reviewer": {"type": "string", "minLength": 1}, "reviewedAt": {"type": "string"},
        "reviewScope": {"type": "string", "minLength": 1},
        "operations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "unresolved": {"type": "array", "maxItems": 0},
        "sharedScreenshotReason": {"type": "string", "minLength": 1},
        "checks": {"type": "object", "additionalProperties": {"type": "boolean"}}
      }
    }}
  }
}
