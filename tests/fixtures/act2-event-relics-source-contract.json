  "contracts": {
    "BloodyIdol": "Actual positive gainGold only, after Ectoplasm gate; heal5 via owner healing, no gain for0. Mark/MagicFlower follow existing context.",
    "MutagenicStrength": "At battle start TOP Strength3,TOP LoseStrength3,TOP visual => loss debt/Artifact resolves BEFORE strength; end first turn loses3 using existing timed-power owner.",
    "Necronomicon": "Each turn activated resets; ATTACK and (costForTurn>=2&&!freeToPlayOnce || baseCost==-1&&energyOnUse>=2). Power onUse before relic onUse; fresh same-UUID purge copy queues before power copies without extra energy, source target preserved.",
    "Necronomicurse": "SPECIAL curse cost-2. onEquip uses real permanent obtain; regular permanent removal directly appends new fresh unupgraded UID WITHOUT obtain hooks; onUnequip removes first raw list match WITHOUT rebound. Exhaust BOTTOM fresh copy to hand after Power exhaust hooks.",
    "Enchiridion": "AtPreBattle full srcCommon/srcUncommon/srcRare POWER+!HEALING list, one cardRandomRng bounded draw; fresh hand card costForTurn0 before first normal draw, once MasterReality upgrade.",
    "NilrysCodex": "Source end-turn held-order action queue before preCard powers/end-turn cards. Three DISTINCT full src!HEALING draws via cardRandomRng rejection; optional0 skip; no retrieval redraw. Chosen normal-cost stat copy inserted random draw slot(size-1), no draw if empty; once MasterReality upgrade.",
    "sharedEndTurn": "One existing ActionQueue list in held order (Orichalcum,Codex,StoneCalendar), current rare-relic owner retains Calendar counters; pause/resume remainder, marker prevents redispatch. Lethal Calendar before Codex suppresses choice; Calendar after waits for selection. Activation is limited to NEW Codex ownership; legacy Orichalcum/Calendar-only paths retain their original state shape."
  },
  "boundaries": "Controlled battle/room/deck fixtures, not natural acquisition or native/device evidence. No immutable historical witness edited. Fixed decompiled source mirror is not authenticated PC binary. Source pools/order and unsupported outcomes remain unfiltered."
