  "behavior": {
    "cursed_tome": {
      "stages": [
        "intro",
        "page_1",
        "page_2",
        "page_3",
        "last_page",
        "reward",
        "result"
      ],
      "hpLossCommands": [
        0,
        1,
        2,
        3,
        10
      ],
      "stopFinalCost": 3,
      "bookOrder": [
        "Necronomicon",
        "Enchiridion",
        "Nilry's Codex"
      ],
      "rng": "one miscRng bounded draw, including singleton/Circlet fallback; no relic queue draw",
      "rewardBoundary": "final cost/draw/offer commits before optional independent claim; missing obtain does not refund prior commands"
    },
    "forgotten_altar": {
      "cost": "cache MathUtils.round(float32(entryMaxHp*0.25f))",
      "shedBloodOrder": [
        "increaseMaxHp5AndHeal",
        "NORMAL cached damage"
      ],
      "idolSwap": "same relic slot; if already Bloody Idol obtain Circlet and retain Golden Idol",
      "smash": "one Decay permanent obtain; no free Leave"
    },
    "drug_dealer": {
      "choices": [
        "one J.A.X.",
        "exactly two transforms",
        "MutagenicStrength or Circlet if owned"
      ],
      "purgeable": "exclude only Necronomicurse,CurseOfTheBell,AscendersBane; bottles included; seven-arg Grid flags all false",
      "transformOrder": [
        "first remove",
        "first misc transform",
        "second remove",
        "second misc transform",
        "first delayed obtain",
        "second delayed obtain"
      ],
      "transformPools": "existing exact colored/colorless/curse source pools, never filter capability or reroll"
    },
    "vampires": {
      "cost": "cache ceil(float32(entryMaxHp*0.3f)), cap entryMaxHp-1",
      "vial": "cache entry presence; lose Blood Vial instead of maxHP",
      "removeOrder": "all exact STARTER_STRIKE-tagged cards in reverse master-deck order, including bottles/upgraded",
      "obtain": "five fresh Bite cards after all removals, even zero strikes"
    }
  },
  "boundaries": "Controlled staged-room tests are not natural pool/native acceptance. Fixed decompiled mirror is not authenticated PC binary. Missing dependency definitions must refuse, never substitutes. Public pool/dispatch/UI integration owned separately; no pool shrink or RNG-owner substitution."
}
