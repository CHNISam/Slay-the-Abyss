        "src/lua/abyss_deck_ui.lua": {
          "beforeSha256": "ef11dda08bb63093434ea212b27b8accd24e07053566a1fc8ad57feb3db4facd",
          "afterSha256": "5115772421b007ba2e61a0f9de0cbfad54591e52741bc776878eb12d63a8d93d",
          "beforeGitBlob": "34c702578aa7ac07eb1cb7a3296be62e90b746d5",
