    "src/lua/abyss_game_ui.lua": {
      "currentSha256": "de356a0a6fcbde4c59d791da8dd3c0f5a047dbf122c74968b154c27931f4f159",
      "targets": {
        "art": {
          "sha256": "f7e4ddf3b5b65b8486f3e05374aa3cdf2b0456094258325a97e2232efbb638ed",
          "hunks": [
