  "generatorJava": "import java.util.Locale;\n\n// Independent Java 17 float-expression vectors; no imported upstream RNG class.\npublic class FloatVectors {\n    public static void main(String[] args) {\n        int[] samples = {0, 0x800000, 0xffffff, 0x900000, 0x5b645a, 0x6a7efa};\n        float[] ranges = {0.0f, -0.0f, 0.9f, 1.1f, -1.1f,\n            Float.MIN_VALUE, 3.0f * Float.MIN_VALUE, Float.MIN_NORMAL, Float.MAX_VALUE};\n        float[][] bounds = {{0.9f, 1.1f}, {1.1f, 0.9f}, {-1.1f, 0.9f}, {1.0f, 1.0f},\n            {Float.MIN_VALUE, 3.0f * Float.MIN_VALUE}, {Float.MIN_NORMAL, Float.MIN_VALUE},\n            {-0.0f, 0.0f}, {-Float.MAX_VALUE, -Float.MAX_VALUE / 2.0f},\n            {Float.MAX_VALUE / 2.0f, Float.MAX_VALUE}, {-Float.MIN_VALUE, Float.MIN_VALUE},\n            {16777216.0f, 16777218.0f}, {1.0f, Math.nextUp(1.0f)}, {-1.0f, 0.1f}};\n        System.out.println(\"[\");\n        boolean first = true;\n        for (int sample : samples) {\n            float u = sample / 16777216.0f;\n            for (float range : ranges) {\n                if (!first) System.out.println(\",\"); first = false;\n                emit(\"range\", sample, range, 0.0f, u * range);\n            }\n            for (float[] pair : bounds) {\n                if (!first) System.out.println(\",\"); first = false;\n                float start = pair[0], end = pair[1];\n                emit(\"between\", sample, start, end, start + u * (end - start));\n            }\n        }\n        System.out.println(\"\\n]\");\n    }\n\n    private static void emit(String kind, int sample, float left, float right, float result) {\n        System.out.printf(Locale.ROOT,\n            \"{\\\"kind\\\":\\\"%s\\\",\\\"sample\\\":%d,\\\"left\\\":%s,\\\"right\\\":%s,\\\"value\\\":%s,\\\"resultBits\\\":\\\"%08x\\\",\\\"negativeZero\\\":%s}\",\n            kind, sample, Double.toString(left), Double.toString(right), Double.toString(result),\n            Float.floatToRawIntBits(result), Float.floatToRawIntBits(result) == 0x80000000);\n    }\n}\n",
