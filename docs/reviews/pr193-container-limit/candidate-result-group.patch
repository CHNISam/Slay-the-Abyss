 local function test(name, fn) fn() count=count+1 print("ok UI " .. count .. " - " .. name) end
 
+test("grouped result stays inert and preserves visibility text and colour across real run transitions", function()
+    for _, embedded in ipairs({ false, true }) do
+        local ui, stage, click = setup({ embedded = embedded })
+        local group = stage:GetChild("resultGroup")
+        local result, plate = group:GetChild("result"), group:GetChild("resultPlate")
+        local function start()
+            if embedded then
+                -- The host owns run creation in embedded mode; its Start button is deliberately unavailable.
+                ui.run = Run.new(Data, 42)
+                assert(Run.startCombat(ui.run, "cultist_solo"))
+                ui:render()
+            else click("start") end
+        end
+        assert(group.visible and not group.click and not group.listeners)
+        assert(result.visible and plate.visible and result.text:find("战斗演练", 1, true))
+        for _, key in ipairs({ "r", "g", "b", "a" }) do
+            assert(result.fontColor[key] == Theme.color.goldBright[key])
+        end
+        start()
+        assert(not result.visible and not plate.visible)
+        for _ = 1, 30 do if ui.run.phase ~= "combat" then break end click("endTurn") end
+        assert(ui.run.phase == "defeat" and result.visible and plate.visible)
+        assert(result.text:find("旅途暂歇", 1, true))
+        for _, key in ipairs({ "r", "g", "b", "a" }) do
+            assert(result.fontColor[key] == Theme.color.danger[key])
+        end
+        local old = ui.run
+        start()
+        assert(ui.run ~= old and ui.run.phase == "combat" and #ui.run.deck == 10)
+        assert(not result.visible and not plate.visible and group.visible)
+        for _, key in ipairs({ "r", "g", "b", "a" }) do
+            assert(result.fontColor[key] == Theme.color.goldBright[key])
+        end
+    end
+end)
