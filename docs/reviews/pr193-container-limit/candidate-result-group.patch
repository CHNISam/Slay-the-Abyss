 import { battleLayout, handPose, theme } from '../scripts/ui-layout.mjs';
 
 const stage = () => battleLayout().controls.find(c => c.name === 'stage');
+test('result backdrop and text share an inert zero-offset group without changing draw order', () => {
+  const controls = stage().children;
+  const index = controls.findIndex(c => c.name === 'resultGroup');
+  assert(index > 0);
+  const group = controls[index];
+  assert.equal(group.kind, 'container');
+  assert.equal(group.focusable, false);
+  assert.deepEqual(group.position, [0, 0]);
+  assert.deepEqual(group.size, theme.canvas.base);
+  assert.equal(group.visible ?? true, true);
+  assert.equal(controls[index - 1].name, 'continue');
+  assert.equal(controls[index + 1].name, 'skip');
+  assert.deepEqual(group.children.map(c => c.name), ['resultPlate', 'result']);
+  assert.deepEqual(group.children.map(c => c.kind), ['image', 'text']);
+  assert.deepEqual(group.children.map(c => c.position), [[0, 80], [0, 80]]);
+  assert.deepEqual(group.children.map(c => c.size), [[800, 130], [780, 122]]);
+});
 test('feedback uses a fixed non-interactive native pool within the per-parent platform limit', () => {
